# ==============================================================================
# JobPilot AI Assistant - Environment Configuration Template
# Copy this file to .env and adjust variables for your environment.
# Never commit the .env file containing actual production secrets to git.
# ==============================================================================

# Application Environment: 'development', 'test', 'production'
ENVIRONMENT=development

# Database Configuration
# Local development fallback: SQLite
DATABASE_URL=sqlite:///./auth.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://db_user:db_password@localhost:5432/job_assistant

# JWT & Authentication Secret Keys
# Generate a secure 64-char key using: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-very-secure-random-secret-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie & Session Security
# Set to True in production behind HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourdomain.com

# Token Lifespans
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1

# Rate Limiting & Account Lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_PASSWORD_RESET_PER_MINUTE=3

# CORS Origins (comma-separated or JSON list)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Frontend URL (used for email verification and password reset links)
FRONTEND_URL=http://localhost:5173

# Email Service Configuration
# In dev mode, verification/reset links are safely logged to the server console
EMAIL_DEV_MODE=true
# Production SMTP settings:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your_smtp_password
# SMTP_TLS=true
# EMAILS_FROM_EMAIL=noreply@jobpilot.ai
# EMAILS_FROM_NAME="JobPilot AI Security"

# Optional Initial Admin Bootstrap on Startup
# FIRST_ADMIN_EMAIL=admin@jobpilot.ai
# FIRST_ADMIN_PASSWORD=AdminSecurePassword123!
# FIRST_ADMIN_NAME="System Administrator"

# AI Service Configuration
# Option 1: Groq API (Recommended - Free and Fast)
GROQ_API_KEY=your_groq_api_key_here

# Option 2: OpenAI API (Alternative)
OPENAI_API_KEY=your_openai_api_key_here

# Adzuna Jobs API (for live job search)
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here
